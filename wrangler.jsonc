{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "games",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {"name": "SIGNAL_ROOMS", "class_name": "SignalRoom"},
      {"name": "INVITE_LIMITS", "class_name": "InviteLimiter"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["SignalRoom", "InviteLimiter"]}
  ],
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  }
}
