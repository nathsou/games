{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "games",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  }
}
